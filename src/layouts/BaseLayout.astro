---
import KomorebiGrid from '@components/KomorebiGrid.astro'

export interface Props {
  title: string
  description?: string
  lang?: string
}

const {
  title,
  description = 'THE NORTH FACE Maternity+ 2025 Fall/Winter Collection',
  lang = 'ja',
} = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/x-icon"
      href="https://www.thenorthface.jp/static/full/tnf/images/favicon.ico"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Lexend:wght@100;200;300;500;600&family=Klee+One:wght@600&display=swap"
      rel="stylesheet"
    />

    <!-- OGP Meta Tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="https://www.goldwin.co.jp/static/full/tnf/assets/images/common/og_image.jpg"
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Global CSS -->
  </head>
  <body>
    <!-- ローディングアニメーション -->
    <div id="loading-overlay">
      <img src="/images/loading-animation.gif" alt="Loading..." />
    </div>
    <KomorebiGrid />
    <slot />

    <script>
      // ローディングアニメーション制御
      window.addEventListener('load', () => {
        const loadingOverlay = document.getElementById('loading-overlay')
        if (loadingOverlay) {
          // フェードアウト効果を追加
          loadingOverlay.style.transition = 'opacity 0.5s ease-out'
          loadingOverlay.style.opacity = '0'

          // アニメーション終了後に要素を削除
          setTimeout(() => {
            loadingOverlay.style.display = 'none'
          }, 500)
        }
      })
    </script>
  </body>
</html>
