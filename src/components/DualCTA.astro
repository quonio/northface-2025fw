---
import { cn } from '@/utils/cn'
import upArrowIcon from '@/assets/images/decorations/icon-up-arrow.svg'

interface Props {
  class?: string
}

const { class: className = '' } = Astro.props
---

<section class={cn('p-0', className)}>
  <div class="flex w-full flex-col md:flex-row">
    <a
      href="https://www.goldwin.co.jp/ap/s/s?rows=80&sort=rk+desc,fsdt+desc&fq=bd:GDW01&fq=tags:%E3%83%9E%E3%82%BF%E3%83%8B%E3%83%86%E3%82%A3&_gl=1*pp87zk*_gcl_au*Mzk4NTE2MjUxLjE3NTE1OTE2NjY.*_ga*MTMwNDAxMzY4My4xNzQzNjM5ODY2*_ga_21RKR286QM*czE3NTg2ODk2MTUkbzcxJGcwJHQxNzU4Njg5NjQwJGozNSRsMCRoMA"
      class="cta-button w-full md:w-1/2 text-paper py-6 md:py-8 lg:py-10 px-4 text-center font-display text-[7.73vw] md:text-xl lg:text-[3.194vw] font-extralight transition-all duration-300 border-b md:border-r border-paper/20 flex items-center justify-center gap-3"
    >
      <span>ALL ITEMS</span>
      <img
        src={upArrowIcon.src}
        alt=""
        class="w-[6.13vw] h-[6.13vw] md:w-6 md:h-6 lg:w-[2.639vw] lg:h-[2.639vw]"
      />
    </a>
    <a
      href="https://www.goldwin.co.jp/store/styling/?pageNo=1&tag=%E3%83%9E%E3%82%BF%E3%83%8B%E3%83%86%E3%82%A3%E3%82%B0%E3%83%83%E3%82%BA&sort=time&_gl=1*pp87zk*_gcl_au*Mzk4NTE2MjUxLjE3NTE1OTE2NjY.*_ga*MTMwNDAxMzY4My4xNzQzNjM5ODY2*_ga_21RKR286QM*czE3NTg2ODk2MTUkbzcxJGcwJHQxNzU4Njg5NjQwJGozNSRsMCRoMA"
      class="cta-button w-full md:w-1/2 text-paper py-6 md:py-8 lg:py-10 px-4 text-center font-display text-[7.73vw] md:text-xl lg:text-[3.194vw] font-extralight transition-all duration-300 flex items-center justify-center gap-3"
    >
      <span>STAFF STYLING</span>
      <img
        src={upArrowIcon.src}
        alt=""
        class="w-[6.13vw] h-[6.13vw] md:w-6 md:h-6 lg:w-[2.639vw] lg:h-[2.639vw]"
      />
    </a>
  </div>
</section>

<style>
  .cta-button {
    position: relative;
    overflow: hidden;
    background-color: var(--color-terra-dark);
  }

  .cta-button::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 100%;
    background: rgba(0, 0, 0, 0.15);
    transition: width 0.3s ease;
    z-index: 1;
  }

  .cta-button > * {
    position: relative;
    z-index: 2;
  }

  .cta-button:hover::before {
    width: 100%;
  }
</style>
